include README.md
include LICENSE
include .dockerignore
recursive-include simind_python_connector/data *.atn
recursive-include simind_python_connector/data *.json
recursive-include simind_python_connector/configs *.smc *.yaml
recursive-include docs *.rst *.py
include docs/_static/.gitkeep
recursive-include tests *.py
recursive-include tests/fixtures *.smc
recursive-include examples *.py *.sh
recursive-include scripts *.py *.sh
recursive-include docker Dockerfile *.md *.txt *.yaml *.yml *.py *.sh
exclude simind_manual.pdf
prune simind
prune docs/_build
prune docs/_generated
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .DS_Store
